rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['learning', 'session', 'sessionUpdatedAt'])
        && request.resource.data.learning is map
        && request.resource.data.sessionUpdatedAt is int
        && (request.resource.data.session == null || request.resource.data.session is map);
    }
  }
}
